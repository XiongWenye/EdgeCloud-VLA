diff --git a/src/lerobot/processor/tokenizer_processor.py b/src/lerobot/processor/tokenizer_processor.py
index df559555..a8e137dd 100644
--- a/src/lerobot/processor/tokenizer_processor.py
+++ b/src/lerobot/processor/tokenizer_processor.py
@@ -574,3 +574,131 @@ class ActionTokenizerProcessorStep(ActionProcessorStep):
             The updated dictionary of policy features.
         """
         return features
+
+
+@dataclass
+@ProcessorStepRegistry.register(name="paligemma_tokenizer_processor")
+class PaliGemmaTokenizerProcessorStep(ObservationProcessorStep):
+    """
+    Processor step to tokenize a natural language task description using the official
+    PaliGemma SentencePiece tokenizer (without HuggingFace hub downloads or state-in-prompt).
+    """
+
+    tokenizer_path: str | None = None
+    tokenizer: Any | None = None
+    max_length: int = 200
+    task_key: str = "task"
+    clean_text: bool = True
+
+    input_tokenizer: Any = field(default=None, init=False, repr=False)
+
+    def __post_init__(self):
+        if self.tokenizer is not None:
+            self.input_tokenizer = self.tokenizer
+            return
+
+        resolved = self._resolve_model_path(self.tokenizer_path)
+        if resolved is None or not resolved.is_file():
+            raise FileNotFoundError(
+                f"Could not resolve PaliGemma tokenizer model file. Checked {self.tokenizer_path!r} and fallback paths."
+            )
+        import sentencepiece
+        self.input_tokenizer = sentencepiece.SentencePieceProcessor(model_file=str(resolved))
+
+    @staticmethod
+    def _resolve_model_path(path_str: str | None) -> Path | None:
+        from pathlib import Path
+        candidates = []
+        if path_str:
+            p = Path(path_str)
+            candidates.extend([
+                p,
+                Path.cwd() / p,
+                Path(__file__).resolve().parent / p,
+                Path("/n/netscratch/ydu_lab/Lab/wxiong/EdgeCloud-VLA") / p,
+                Path("/n/netscratch/ydu_lab/Lab/wxiong/EdgeCloud-VLA/artifacts/pi05_libero_base_official_aligned") / p,
+                Path("/n/netscratch/ydu_lab/Lab/wxiong/EdgeCloud-VLA/cache/openpi_reference/big_vision") / p,
+            ])
+        candidates.extend([
+            Path("/n/netscratch/ydu_lab/Lab/wxiong/EdgeCloud-VLA/artifacts/pi05_libero_base_official_aligned/paligemma_tokenizer.model"),
+            Path("/n/netscratch/ydu_lab/Lab/wxiong/EdgeCloud-VLA/cache/openpi_reference/big_vision/paligemma_tokenizer.model"),
+            Path.cwd() / "paligemma_tokenizer.model",
+            Path.cwd() / "cache/openpi_reference/big_vision/paligemma_tokenizer.model",
+        ])
+        for c in candidates:
+            if c.is_file():
+                return c.resolve()
+        return None
+
+    def get_task(self, transition: EnvTransition) -> list[str] | None:
+        complementary_data = transition.get(TransitionKey.COMPLEMENTARY_DATA)
+        if complementary_data is None:
+            raise ValueError("Complementary data is None so no task can be extracted from it")
+
+        task = complementary_data.get(self.task_key)
+        if task is None:
+            raise ValueError(f"Task key {self.task_key!r} not found in complementary data")
+
+        if isinstance(task, str):
+            return [task]
+        elif isinstance(task, list) and all(isinstance(t, str) for t in task):
+            return task
+        return None
+
+    def _detect_device(self, transition: EnvTransition) -> torch.device | None:
+        observation = transition.get(TransitionKey.OBSERVATION)
+        if observation:
+            for value in observation.values():
+                if isinstance(value, torch.Tensor):
+                    return value.device
+        action = transition.get(TransitionKey.ACTION)
+        if isinstance(action, torch.Tensor):
+            return action.device
+        return None
+
+    def observation(self, observation: RobotObservation) -> RobotObservation:
+        tasks = self.get_task(self.transition)
+        if tasks is None:
+            raise ValueError("Task cannot be None")
+
+        tokens_list = []
+        masks_list = []
+
+        for task_str in tasks:
+            cleaned = task_str.strip().replace("_", " ").replace("\n", " ") if self.clean_text else task_str
+            tok_ids = self.input_tokenizer.encode(cleaned, add_bos=True) + self.input_tokenizer.encode("\n")
+            if len(tok_ids) > self.max_length:
+                tok_ids = tok_ids[: self.max_length]
+                mask = [True] * self.max_length
+            else:
+                mask = [True] * len(tok_ids) + [False] * (self.max_length - len(tok_ids))
+                tok_ids = tok_ids + [0] * (self.max_length - len(tok_ids))
+
+            tokens_list.append(torch.tensor(tok_ids, dtype=torch.long))
+            masks_list.append(torch.tensor(mask, dtype=torch.bool))
+
+        tokens_tensor = torch.stack(tokens_list, dim=0)
+        masks_tensor = torch.stack(masks_list, dim=0)
+
+        target_device = self._detect_device(self.transition)
+        if target_device is not None:
+            tokens_tensor = tokens_tensor.to(target_device)
+            masks_tensor = masks_tensor.to(target_device)
+
+        new_observation = dict(observation)
+        new_observation[OBS_LANGUAGE_TOKENS] = tokens_tensor
+        new_observation[OBS_LANGUAGE_ATTENTION_MASK] = masks_tensor
+        return new_observation
+
+    def get_config(self) -> dict[str, Any]:
+        return {
+            "tokenizer_path": str(self.tokenizer_path) if self.tokenizer_path is not None else "paligemma_tokenizer.model",
+            "max_length": self.max_length,
+            "task_key": self.task_key,
+            "clean_text": self.clean_text,
+        }
+
+    def transform_features(
+        self, features: dict[PipelineFeatureType, dict[str, PolicyFeature]]
+    ) -> dict[PipelineFeatureType, dict[str, PolicyFeature]]:
+        return features
